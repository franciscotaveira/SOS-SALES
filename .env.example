# SOS Sales V3 — Environment Baseline (Docker Lab & Local Development)
NODE_ENV=development

# Services Ports
PORT_WEB=3400
PORT_API=4400
PORT_POSTGRES=55440
PORT_REDIS=6389
PORT_MINIO=9008
PORT_MINIO_CONSOLE=9009

# App URLs
VITE_API_URL=http://localhost:4400
API_HOST=0.0.0.0
API_PORT=4400

# Database Configuration (Hermetic Local Postgres V3)
# Runtime App Connection (Strictly restricted to DML and subject to RLS)
DATABASE_URL=postgresql://sos_app_user:sos_app_secret_2026@localhost:55440/sos_sales_v3?sslmode=disable

# Migration & DDL Connection (Owner privileges for schema migrations only)
MIGRATION_DATABASE_URL=postgresql://sos_migration_owner:sos_migration_secret_2026@localhost:55440/sos_sales_v3?sslmode=disable

POSTGRES_USER=sos_user
POSTGRES_PASSWORD=sos_secret_lab_2026
POSTGRES_DB=sos_sales_v3

# Redis Configuration (Hermetic Local Redis V3)
REDIS_URL=redis://localhost:6389

# Security & Secrets Encryption (ADR-003)
# Gere uma chave mestra criptograficamente segura de 32 bytes (64 caracteres hexadecimais):
# Exemplo no terminal: openssl rand -hex 32
APP_MASTER_KEY=

# Authentication & Identity Provider (ADR-002)
# Explicit choice: 'local-jwt' or 'supabase-jwks'
AUTH_PROVIDER=local-jwt
# Gere um segredo seguro para assinatura de JWT com no mínimo 32 caracteres:
# Exemplo no terminal: openssl rand -base64 32
JWT_SECRET=
AUTH_ISSUER=chat-sales-v3
AUTH_AUDIENCE=chat-sales-api

# Optional: Supabase Auth Configuration (when AUTH_PROVIDER=supabase-jwks)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Observability
LOG_LEVEL=info
OTEL_SERVICE_NAME=sos-sales-v3
