# =============================================================================
# SOS SALES — PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.production on the VPS host and fill with real credentials.
# NEVER commit the filled .env.production file to version control.

# DOMAIN & SSL (Caddy Reverse Proxy)
DOMAIN=sos.mct.com.br

# DATABASE (Supabase Remote Instance / PostgreSQL 17)
DATABASE_URL=postgresql://postgres:[SUPABASE_DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DATABASE_POOL_MAX=20

# REDIS (Internal container credentials)
REDIS_PASSWORD=[GENERATE_STRONG_RANDOM_PASSWORD_HERE]

# SUPABASE AUTH & JWT
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[SUPABASE_ANON_PUBLIC_KEY]
SUPABASE_JWT_ISSUER=https://[PROJECT_REF].supabase.co/auth/v1
SUPABASE_JWKS_URL=https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# WAHA (WhatsApp HTTP API)
WAHA_API_KEY=[GENERATE_STRONG_WAHA_API_KEY]
WAHA_WEBHOOK_SECRET=[GENERATE_STRONG_WEBHOOK_SECRET]
