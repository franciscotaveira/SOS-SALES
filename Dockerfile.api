# Stage 1: Build API
FROM node:22-alpine AS builder
WORKDIR /app

ARG GIT_COMMIT_SHA
ENV GIT_COMMIT_SHA=$GIT_COMMIT_SHA
ARG APP_ENV=production
ENV APP_ENV=$APP_ENV

COPY apps/api/package*.json ./
RUN npm ci

COPY apps/api/tsconfig.json ./
COPY apps/api/scripts ./scripts
COPY apps/api/src ./src

# Runtime images only execute JavaScript; declaration generation is validated
# separately by `tsc --noEmit` and must not block container assembly.
RUN npx tsup src/index.ts --format esm && node scripts/generate-release-manifest.mjs

# Stage 2: Production Runner
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4334
ENV HOST=0.0.0.0

COPY apps/api/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=builder /app/dist ./dist

USER node

EXPOSE 4334

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:4334/health || exit 1

CMD ["node", "dist/index.js"]
