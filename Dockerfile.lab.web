# Stage 1: Build Frontend for Test / Lab environment
FROM oven/bun:1.2-alpine AS builder
WORKDIR /app

# Copy dependency definitions
COPY package.json bun.lock* ./
RUN bun install

# Copy source code and build
COPY . .
ARG VITE_SOS_API_URL=/api/v1
ARG VITE_SUPABASE_URL=https://yiiuebhyqixzluguxsqi.supabase.co
ARG VITE_SUPABASE_ANON_KEY=sb_publishable_4Mq9Nya3JTrs7OuqkjSa9g_Bs3g1Dgt

ENV VITE_SOS_API_URL=$VITE_SOS_API_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

RUN bun run build

# Stage 2: Serve SPA in Nginx Lab
FROM nginx:1.27-alpine AS runner
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/nginx.lab.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
