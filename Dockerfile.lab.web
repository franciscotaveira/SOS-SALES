# Build the SPA with Lab endpoints. Copying the host `dist/` is unsafe here:
# Vite embeds environment variables at build time, so a production-built dist
# would make the local Lab authenticate and call production services.
FROM node:22-alpine AS builder
WORKDIR /app

ARG VITE_SOS_API_URL=/api/v1
ARG VITE_SUPABASE_URL=http://localhost:55431
ARG VITE_SUPABASE_ANON_KEY

ENV VITE_SOS_API_URL=$VITE_SOS_API_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

COPY package*.json ./
# Rollup selects a platform-specific optional native package. Explicitly
# include optional dependencies so Lab builds reproduce on arm64 and amd64.
RUN npm ci --include=optional
# npm can omit Rollup's native optional package in cross-platform lockfile
# installs. Restore the exact package for the BuildKit target architecture.
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      arm64) npm install --no-save @rollup/rollup-linux-arm64-musl@4.62.4 lightningcss-linux-arm64-musl@1.32.0 @tailwindcss/oxide-linux-arm64-musl@4.3.3 ;; \
      amd64) npm install --no-save @rollup/rollup-linux-x64-musl@4.62.4 lightningcss-linux-x64-musl@1.32.0 @tailwindcss/oxide-linux-x64-musl@4.3.3 ;; \
      *) echo "Unsupported TARGETARCH=$TARGETARCH" && exit 1 ;; \
    esac
COPY . .
RUN npm run build

FROM nginx:1.27-alpine AS runner
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/nginx.lab.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
