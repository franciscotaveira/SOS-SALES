# Ambiente
NODE_ENV=development
PORT=4334
HOST=0.0.0.0

# Supabase Local Isolado (SOS Sales)
SUPABASE_URL=http://localhost:55431
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STUDIO_URL=http://localhost:55433
# Operator API JWT boundary. Configure both values together; otherwise
# /api/v1/me and /api/v1/workspaces remain fail-closed (401).
# Local defaults may differ if you changed supabase/config.toml.
SUPABASE_JWT_ISSUER=http://localhost:55431/auth/v1
SUPABASE_JWKS_URL=http://localhost:55431/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Conexão Direta PostgreSQL (Supabase DB - Porta 55432 isolada)
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/postgres

# Filas & Cache (Redis Isolado)
REDIS_URL=redis://localhost:6381

# Segurança
APP_SECRET=your_app_secret_here

# Meta Cloud & CAPI
META_API_VERSION=v25.0
META_PIXEL_ID=your_pixel_id
META_CAPI_ACCESS_TOKEN=your_capi_token

# WhatsApp Adapter (WAHA ou Cloud API)
WHATSAPP_ENGINE=waha
WHATSAPP_API_URL=http://localhost:8081
WHATSAPP_API_KEY=your_whatsapp_api_key

# Provedor de IA
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL_DECISION=meta-llama/llama-3.1-8b-instruct
AI_MODEL_REASONING=anthropic/claude-3.5-sonnet
AI_REQUEST_TIMEOUT_MS=15000
