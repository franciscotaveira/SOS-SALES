{
  "name": "sos-sales-api",
  "version": "1.0.0",
  "description": "Sistema Operacional de Continuidade Comercial e Navegação de Vendas",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:waha": "tsx watch src/local-waha.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "infra:up": "npx supabase start && docker compose up -d sos-redis",
    "infra:down": "npx supabase stop && docker compose down",
    "waha:up": "docker compose up -d sos-waha",
    "waha:down": "docker compose stop sos-waha",
    "db:reset": "npx supabase db reset",
    "db:wait": "tsx scripts/db-wait.ts",
    "check": "tsc --noEmit && vitest run --no-file-parallelism",
    "check:fresh": "npm run db:reset && npm run db:wait && npm run check",
    "test": "vitest run --no-file-parallelism",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:coverage": "vitest run --coverage --no-file-parallelism",
    "test:watch": "vitest"
  },
  "keywords": [
    "crm",
    "commercial-core",
    "whatsapp",
    "meta-ads",
    "event-driven"
  ],
  "author": "MCT LTDA",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.5.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@fastify/websocket": "^10.0.1",
    "bullmq": "^5.8.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "fastify-type-provider-zod": "^1.1.9",
    "ioredis": "^5.4.1",
    "jose": "^5.10.0",
    "pg": "^8.11.5",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "tsup": "^8.0.2",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
