    "@sos-sales/domain": "workspace:*",
    "@sos-sales/observability": "workspace:*",
    "bullmq": "^5.41.6",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
