{
    email admin@mct.com.br
}

# 1. Landing Page Oficial (Vendas + Demo Interativa)
iaparavendas.tech, www.iaparavendas.tech {
    root * /var/www/landing
    try_files {path} /index.html
    file_server
}

# 2. Aplicação CRM & API Fastify
crm.iaparavendas.tech, sos.mct.com.br {
    # Backend API e Swagger
    handle /api/* {
        reverse_proxy sos-sales-api:4334
    }

    handle /webhooks/* {
        reverse_proxy sos-sales-api:4334
    }

    handle /health {
        reverse_proxy sos-sales-api:4334
    }

    handle /ready {
        reverse_proxy sos-sales-api:4334
    }

    handle /docs* {
        reverse_proxy sos-sales-api:4334
    }

    # Frontend Single Page App
    handle {
        root * /var/www/html
        try_files {path} /index.html
        file_server
    }
}

# 3. Acesso direto por IP (HTTP)
:80 {
    handle /api/* {
        reverse_proxy sos-sales-api:4334
    }

    handle /webhooks/* {
        reverse_proxy sos-sales-api:4334
    }

    handle /health {
        reverse_proxy sos-sales-api:4334
    }

    handle /ready {
        reverse_proxy sos-sales-api:4334
    }

    handle /docs* {
        reverse_proxy sos-sales-api:4334
    }

    handle {
        root * /var/www/html
        try_files {path} /index.html
        file_server
    }
}
