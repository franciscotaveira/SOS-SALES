{
  "name": "sos-sales-crm",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "web:install": "bun install --frozen-lockfile",
    "web:check": "bun run lint",
    "web:build": "bun run build",
    "api:install": "npm --prefix apps/api ci",
    "api:build": "npm --prefix apps/api run build",
    "api:check": "npm --prefix apps/api run check",
    "check:web": "bun run web:check && bun run web:build",
    "check:api": "npm run api:check && npm run api:build",
    "check": "npm run check:web && npm run check:api",
    "generate:openapi": "npm --prefix apps/api run generate:openapi",
    "smoke": "bash scripts/smoke-test.sh",
    "audit:contracts": "node scripts/audit-frontend-backend-contract.mjs",
    "test:live-sync": "node scripts/test-live-cockpit-sync.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
