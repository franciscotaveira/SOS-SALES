{
  "name": "sos-sales-v3",
  "version": "3.0.0-alpha.1",
  "private": true,
  "description": "SOS Sales V3 — Commercial Operating System (Greenfield Sovereign Architecture)",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "landing:dev": "npx -y serve landing -l 3500",
    "test": "vitest run",
    "test:db:bootstrap": "ALLOW_TEST_DB_ADMIN_OPERATIONS=true tsx scripts/test-db-runner.ts bootstrap",
    "test:db:dispose": "ALLOW_TEST_DB_ADMIN_OPERATIONS=true tsx scripts/test-db-runner.ts dispose",
    "test:db:run": "ALLOW_TEST_DB_ADMIN_OPERATIONS=true tsx scripts/test-db-runner.ts run",
    "seed:local": "tsx scripts/seed-local-demo.ts",
    "test:docker:http": "node --env-file=.env scripts/verify-docker-http.mjs",
    "test:docker:e2e": "tsx scripts/test-docker-e2e.ts",
    "test:browser": "node scripts/verify-browser-qa.mjs",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "ci:gate": "tsx scripts/ci-gate-runner.ts",
    "ci:check": "tsx scripts/ci-gate-runner.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules && rm -rf node_modules"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^5.0.1"
  }
}
